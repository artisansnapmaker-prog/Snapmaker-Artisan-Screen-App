<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iv_home_back_start"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/home" />

    <fabscreen.platform.core.ui.view.VideoPlayerIJK
        android:id="@+id/vp_home_back"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v_top_container"
        android:layout_width="0dp"
        android:layout_height="132dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btn_a400_home_top_bar_about_entry"
        android:layout_width="@dimen/icon_size_68"
        android:layout_height="@dimen/icon_size_68"
        android:layout_marginStart="@dimen/margin_layout_48"
        android:background="@drawable/a400_card_home_round_rect_dark_grey"
        android:paddingHorizontal="15dp"
        android:src="@drawable/ic_about_machine"
        app:layout_constraintBottom_toBottomOf="@id/v_top_container"
        app:layout_constraintStart_toStartOf="@id/v_top_container"
        app:layout_constraintTop_toTopOf="@id/v_top_container" />

    <TextView
        android:id="@+id/tv_a400_home_top_bar_title"
        style="@style/AppTheme.TextTitleSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:text="@string/a400_snapmaker_artisan"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/v_top_container"
        app:layout_constraintStart_toEndOf="@id/btn_a400_home_top_bar_about_entry"
        app:layout_constraintTop_toTopOf="@id/v_top_container" />

    <Button
        android:id="@+id/btn_a400_home_top_bar_replace_model"
        android:layout_width="@dimen/icon_size_68"
        android:layout_height="@dimen/icon_size_68"
        android:layout_marginEnd="@dimen/margin_layout_48"
        android:background="@drawable/ic_a400_home_replace_model"
        app:layout_constraintBottom_toBottomOf="@id/v_top_container"
        app:layout_constraintEnd_toEndOf="@id/v_top_container"
        app:layout_constraintTop_toTopOf="@id/v_top_container" />

    <Button
        android:id="@+id/btn_a400_home_top_bar_luban"
        android:layout_width="@dimen/icon_size_68"
        android:layout_height="@dimen/icon_size_68"
        android:layout_marginEnd="@dimen/margin_layout_12"
        android:background="@drawable/ic_a400_home_luban_68x68"
        app:layout_constraintBottom_toBottomOf="@id/v_top_container"
        app:layout_constraintEnd_toStartOf="@id/btn_a400_home_top_bar_replace_model"
        app:layout_constraintTop_toTopOf="@id/v_top_container" />

    <Button
        android:id="@+id/btn_a400_home_top_bar_cloud"
        android:layout_width="@dimen/icon_size_68"
        android:layout_height="@dimen/icon_size_68"
        android:layout_marginEnd="@dimen/margin_layout_12"
        android:background="@drawable/ic_a400_home_cloud_68x68"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/v_top_container"
        app:layout_constraintEnd_toStartOf="@id/btn_a400_home_top_bar_luban"
        app:layout_constraintTop_toTopOf="@id/v_top_container" />

    <Button
        android:id="@+id/btn_a400_home_top_bar_wifi"
        android:layout_width="@dimen/icon_size_68"
        android:layout_height="@dimen/icon_size_68"
        android:layout_marginEnd="@dimen/margin_layout_12"
        android:background="@drawable/ic_a400_home_wifi_no_link_68x68"
        app:layout_constraintBottom_toBottomOf="@id/v_top_container"
        app:layout_constraintEnd_toStartOf="@id/btn_a400_home_top_bar_cloud"
        app:layout_constraintTop_toTopOf="@id/v_top_container" />

    <Button
        android:id="@+id/btn_a400_home_top_bar_monitor"
        android:layout_width="@dimen/icon_size_68"
        android:layout_height="@dimen/icon_size_68"
        android:layout_marginEnd="@dimen/margin_layout_12"
        android:background="@drawable/ic_a400_home_monitor_68x68"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/v_top_container"
        app:layout_constraintEnd_toStartOf="@id/btn_a400_home_top_bar_wifi"
        app:layout_constraintTop_toTopOf="@id/v_top_container" />


    <RelativeLayout
        android:id="@+id/rl_a400_home_navigate_control"
        android:layout_width="240dp"
        android:layout_height="185dp"
        android:layout_marginStart="@dimen/margin_48dp"
        android:layout_marginTop="@dimen/margin_16dp"
        android:background="@drawable/a400_card_home_round_rect_dark_grey"
        app:layout_constraintBottom_toTopOf="@id/rl_a400_home_navigate_calibration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_top_container"
        app:layout_constraintVertical_chainStyle="spread">

        <ImageView
            android:id="@+id/iv_a400_home_navigate_control"
            android:layout_width="@dimen/icon_size_68"
            android:layout_height="@dimen/icon_size_68"
            android:layout_marginStart="@dimen/margin_layout_48"
            android:layout_marginTop="36dp"
            android:src="@drawable/ic_a400_home_control_68x68" />

        <TextView
            style="@style/AppTheme.TextBody1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/iv_a400_home_navigate_control"
            android:layout_alignLeft="@+id/iv_a400_home_navigate_control"
            android:layout_marginTop="13dp"
            android:text="@string/home_control"
            android:textAlignment="textStart"
            android:textColor="?attr/theme_color_title_primary" />

    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/rl_a400_home_navigate_calibration"
        android:layout_width="240dp"
        android:layout_height="185dp"
        android:layout_marginVertical="24dp"
        android:background="@drawable/a400_card_home_round_rect_dark_grey"
        app:layout_constraintBottom_toTopOf="@id/rl_a400_home_navigate_settings"
        app:layout_constraintStart_toStartOf="@id/rl_a400_home_navigate_control"
        app:layout_constraintTop_toBottomOf="@id/rl_a400_home_navigate_control"
        app:layout_constraintVertical_chainStyle="spread">

        <ImageView
            android:id="@+id/iv_a400_home_navigate_calibration"
            android:layout_width="@dimen/icon_size_68"
            android:layout_height="@dimen/icon_size_68"
            android:layout_marginStart="@dimen/margin_layout_48"
            android:layout_marginTop="36dp"
            android:src="@drawable/ic_a400_home_calibration_68x68" />

        <TextView
            android:id="@+id/tv_home_navigate_calibration"
            style="@style/AppTheme.TextBody1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/iv_a400_home_navigate_calibration"
            android:layout_alignLeft="@+id/iv_a400_home_navigate_calibration"
            android:layout_marginTop="13dp"
            android:text="@string/home_calibration"
            android:textAlignment="textStart"
            android:textColor="?attr/theme_color_title_primary" />

    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/rl_a400_home_navigate_settings"
        android:layout_width="240dp"
        android:layout_height="185dp"
        android:layout_marginBottom="@dimen/margin_layout_48"
        android:background="@drawable/a400_card_home_round_rect_dark_grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/rl_a400_home_navigate_calibration"
        app:layout_constraintTop_toBottomOf="@id/rl_a400_home_navigate_calibration"
        app:layout_constraintVertical_chainStyle="spread">

        <ImageView
            android:id="@+id/iv_a400_home_navigate_settings"
            android:layout_width="@dimen/icon_size_68"
            android:layout_height="@dimen/icon_size_68"
            android:layout_marginStart="@dimen/margin_layout_48"
            android:layout_marginTop="@dimen/margin_layout_32"
            android:src="@drawable/ic_a400_home_settings_68x68" />

        <TextView
            style="@style/AppTheme.TextBody1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/iv_a400_home_navigate_settings"
            android:layout_alignLeft="@+id/iv_a400_home_navigate_settings"
            android:layout_marginTop="13dp"
            android:text="@string/home_setting"
            android:textAlignment="textStart"
            android:textColor="?attr/theme_color_title_primary" />

    </RelativeLayout>

    <FrameLayout
        android:id="@+id/fl_a400_home_fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_layout_24"
        android:layout_marginTop="@dimen/margin_layout_16"
        android:layout_marginEnd="@dimen/margin_layout_48"
        android:layout_marginBottom="@dimen/margin_layout_48"
        android:background="@drawable/shape_bg_home_print"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/rl_a400_home_navigate_control"
        app:layout_constraintTop_toBottomOf="@id/v_top_container" />
</androidx.constraintlayout.widget.ConstraintLayout>

