<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:saveEnabled="false" />

    <RelativeLayout
        android:layout_width="780dp"
        android:layout_height="wrap_content"
        android:background="@drawable/all_dialog_round_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/tip_icon"
            android:layout_width="@dimen/icon_size_112"
            android:layout_height="@dimen/icon_size_112"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_layout_20"
            android:src="@drawable/ic_pic_a400_error_112x112" />

        <TextView
            android:id="@+id/title_tv"
            style="@style/AppTheme.TextTitleSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tip_icon"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="64dp"
            android:layout_marginTop="48dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tip_tv"
            style="@style/AppTheme.TextBody2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/title_tv"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="@dimen/margin_64dp"
            android:layout_marginTop="@dimen/margin_layout_24"
            android:gravity="center"
            android:textColor="@color/palette_white_silver" />

        <View
            android:id="@+id/v_background"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_80"
            android:layout_below="@id/tip_tv" />

        <View
            android:id="@+id/v_drop_shadow_line"
            style="@style/AppTheme.LineDropShadow"
            android:layout_width="match_parent"
            android:layout_below="@id/tip_tv"
            android:layout_marginTop="@dimen/margin_layout_48" />

        <TextView
            android:id="@+id/tv_continue"
            style="@style/AppTheme.TextBody1"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_below="@id/v_drop_shadow_line"
            android:gravity="center"
            android:text="@string/all_continue"
            android:textSize="?attr/theme_font_size_body1" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
