<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_main_pic"
        android:layout_width="578dp"
        android:layout_height="434dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="66dp"
        app:cardCornerRadius="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <fabscreen.platform.core.ui.view.VideoPlayerIJK
            android:id="@+id/iv_unloading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_manual_unloading_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:gravity="start"
        android:text="@string/a400_settings_replace_hotend_manual_unload_desc"
        android:textColor="@color/palette_white_pure"
        android:textSize="28sp"
        app:layout_constraintBottom_toTopOf="@id/v_btn_container_l"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cv_main_pic"
        app:layout_constraintTop_toTopOf="@id/cv_main_pic"
        app:layout_constraintVertical_chainStyle="packed" />

    <View
        android:id="@+id/v_btn_container_l"
        android:layout_width="279dp"
        android:layout_height="318dp"
        android:layout_marginTop="5dp"
        app:layout_constraintBottom_toBottomOf="@id/cv_main_pic"
        app:layout_constraintStart_toStartOf="@id/tv_manual_unloading_desc"
        app:layout_constraintTop_toBottomOf="@id/tv_manual_unloading_desc" />

    <View
        android:id="@+id/v_btn_container_r"
        android:layout_width="279dp"
        android:layout_height="318dp"
        app:layout_constraintStart_toEndOf="@id/v_btn_container_l"
        app:layout_constraintTop_toTopOf="@id/v_btn_container_l" />

    <Button
        android:id="@+id/btn_unload_l"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/a400_filament_unload"
        app:layout_constraintBottom_toTopOf="@id/tv_unload_l"
        app:layout_constraintEnd_toEndOf="@id/v_btn_container_l"
        app:layout_constraintStart_toStartOf="@id/v_btn_container_l"
        app:layout_constraintTop_toTopOf="@id/v_btn_container_l"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_unload_l"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/a400_settings_replace_hotend_unload_l_filament"
        android:textColor="@color/palette_white_pure"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@id/v_btn_container_l"
        app:layout_constraintEnd_toEndOf="@id/btn_unload_l"
        app:layout_constraintStart_toStartOf="@id/btn_unload_l"
        app:layout_constraintTop_toBottomOf="@id/btn_unload_l" />

    <Button
        android:id="@+id/btn_unload_r"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/a400_filament_unload"
        app:layout_constraintBottom_toTopOf="@id/tv_unload_r"
        app:layout_constraintEnd_toEndOf="@id/v_btn_container_r"
        app:layout_constraintStart_toStartOf="@id/v_btn_container_r"
        app:layout_constraintTop_toTopOf="@id/v_btn_container_r"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_unload_r"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/a400_settings_replace_hotend_unload_r_filament"
        android:textColor="@color/palette_white_pure"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@id/v_btn_container_r"
        app:layout_constraintEnd_toEndOf="@id/btn_unload_r"
        app:layout_constraintStart_toStartOf="@id/btn_unload_r"
        app:layout_constraintTop_toBottomOf="@id/btn_unload_r" />

    <Button
        android:id="@+id/btn_next"
        style="@style/AppTheme.PrimaryButton"
        android:layout_width="230dp"
        android:layout_height="92dp"
        android:layout_margin="48dp"
        android:text="@string/all_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>