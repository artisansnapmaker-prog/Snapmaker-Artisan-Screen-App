<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/v_top_bar"
        layout="@layout/widget_a400_setting_top_bar" />

    <ScrollView
        android:id="@+id/sv_module_list"
        android:layout_width="532dp"
        android:layout_height="0dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/shape_bg_a400_module_assist_modules"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_top_bar">

        <LinearLayout
            android:id="@+id/ll_module_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="38dp"
            android:paddingVertical="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="38dp"
                android:text="@string/a400_module_assist_current_plug_in_modules_title"
                android:textColor="#737373"
                android:textSize="24sp" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/btn_replace_module"
        android:layout_width="281dp"
        android:layout_height="180dp"
        android:layout_marginStart="21dp"
        android:background="@drawable/selector_bg_a400_module_assist_btn"
        app:layout_constraintStart_toEndOf="@id/sv_module_list"
        app:layout_constraintTop_toTopOf="@id/sv_module_list" />

    <ImageView
        android:id="@+id/iv_replace_module_icon"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginStart="30dp"
        android:src="@drawable/ic_replace_module"
        android:translationZ="2dp"
        app:layout_constraintBottom_toBottomOf="@id/btn_replace_module"
        app:layout_constraintStart_toStartOf="@id/btn_replace_module"
        app:layout_constraintTop_toTopOf="@id/btn_replace_module" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="30dp"
        android:text="@string/replace_module_title"
        android:textColor="#C9C9C9"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_replace_module_icon"
        app:layout_constraintEnd_toEndOf="@id/btn_replace_module"
        app:layout_constraintStart_toEndOf="@id/iv_replace_module_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_replace_module_icon" />

    <View
        android:id="@+id/btn_replace_hotend"
        android:layout_width="281dp"
        android:layout_height="180dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/selector_bg_a400_module_assist_btn"
        app:layout_constraintStart_toStartOf="@id/btn_replace_module"
        app:layout_constraintTop_toBottomOf="@id/btn_replace_module" />

    <ImageView
        android:id="@+id/iv_replace_hotend_icon"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginStart="30dp"
        android:src="@drawable/ic_replace_hot_end"
        android:translationZ="2dp"
        app:layout_constraintBottom_toBottomOf="@id/btn_replace_hotend"
        app:layout_constraintStart_toStartOf="@id/btn_replace_hotend"
        app:layout_constraintTop_toTopOf="@id/btn_replace_hotend" />

    <TextView
        android:id="@+id/tv_replace_hotend"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="30dp"
        android:text="@string/replace_hotend_title"
        android:textColor="#C9C9C9"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_replace_hotend_icon"
        app:layout_constraintEnd_toEndOf="@id/btn_replace_hotend"
        app:layout_constraintStart_toEndOf="@id/iv_replace_hotend_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_replace_hotend_icon" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_replace_hotend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:constraint_referenced_ids="btn_replace_hotend,iv_replace_hotend_icon,tv_replace_hotend" />

    <View
        android:id="@+id/view_transparent_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
