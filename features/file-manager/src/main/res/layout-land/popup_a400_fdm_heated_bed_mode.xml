<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="218dp"
    android:background="@drawable/shape_bg_a400_popup"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_browse_pop_up_heated_bed_mode_whole_bed"
        android:layout_width="0dp"
        android:layout_height="109dp"
        android:gravity="center|start"
        android:paddingHorizontal="48dp"
        android:text="@string/a400_popup_fdm_heated_bed_mode_whole_bed"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_browse_pop_up_heated_bed_mode_inner_zone"
        android:layout_width="0dp"
        android:layout_height="109dp"
        android:gravity="center|start"
        android:paddingHorizontal="48dp"
        android:text="@string/a400_popup_fdm_heated_bed_mode_inner_zone"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
