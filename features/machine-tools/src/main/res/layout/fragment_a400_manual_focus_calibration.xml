<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/a400_progress_top_bar" />

    <ImageView
        android:id="@+id/iv_calibration_desc"
        android:layout_width="0dp"
        android:layout_height="359dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toStartOf="@+id/v_control_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_main_pic"
        android:layout_width="0dp"
        android:layout_height="359dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="32dp"
        android:visibility="gone"
        app:cardCornerRadius="18dp"
        app:layout_constraintEnd_toStartOf="@+id/v_control_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress">

        <fabscreen.platform.core.ui.view.VideoPlayerIJK
            android:id="@+id/vp_main_pic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_calibration_desc_title"
        style="@style/AppTheme.TextBody1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_24"
        android:text="@string/all_touch_material_title"
        app:layout_constraintStart_toStartOf="@id/iv_calibration_desc"
        app:layout_constraintTop_toBottomOf="@id/iv_calibration_desc" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_layout_12"
        android:layout_marginBottom="@dimen/margin_layout_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/iv_calibration_desc"
        app:layout_constraintStart_toStartOf="@+id/iv_calibration_desc"
        app:layout_constraintTop_toBottomOf="@+id/tv_calibration_desc_title">

        <TextView
            android:id="@+id/tv_calibration_desc_content"
            style="@style/AppTheme.TextExplain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </ScrollView>

    <View
        android:id="@+id/v_control_bg"
        android:layout_width="705dp"
        android:layout_height="0dp"
        android:layout_marginStart="48dp"
        android:background="@color/palette_grey_nero"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_calibration_desc"
        app:layout_constraintTop_toBottomOf="@id/progress" />


    <fabscreen.platform.core.ui.view.A400XYZBControlPanel
        android:id="@+id/cp_a400_calibration_move"
        android:layout_width="609dp"
        android:layout_height="423dp"
        android:layout_marginTop="@dimen/margin_layout_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/v_control_bg"
        app:layout_constraintTop_toBottomOf="@+id/progress" />

    <TextView
        style="@style/AppTheme.LineDropShadow"
        android:layout_width="0dp"
        android:layout_marginBottom="36dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/v_control_bg" />

    <TextView
        android:id="@+id/btn_run_boundary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="72dp"
        android:text="@string/control_run_boundary"
        android:textColor="@color/palette_blue_ribbon"
        android:textSize="28sp"
        app:layout_constraintBottom_toBottomOf="@id/v_control_bg"
        app:layout_constraintStart_toStartOf="@id/v_control_bg" />

    <Button
        android:id="@+id/btn_next"
        style="@style/AppTheme.PrimaryButton"
        android:layout_width="230dp"
        android:layout_height="92dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="48dp"
        android:text="@string/all_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
