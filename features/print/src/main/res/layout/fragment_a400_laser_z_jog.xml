<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/theme_color_page_background">

    <include layout="@layout/merge_left_vertical_pic_text" />

    <View
        android:id="@+id/fcv_jog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="48dp"
        android:background="@color/palette_grey_nero"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cv_main_pic"
        app:layout_constraintTop_toTopOf="parent" />

    <fabscreen.platform.core.ui.view.A400XYZBControlPanel
        android:id="@+id/xyzb_calibration_control"
        android:layout_width="0dp"
        android:layout_height="423dp"
        android:layout_marginStart="@dimen/margin_layout_96"
        android:layout_marginTop="@dimen/margin_layout_32"
        android:layout_marginEnd="@dimen/margin_layout_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cv_main_pic"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginStart="@dimen/margin_layout_48"
        android:layout_marginBottom="176dp"
        android:background="?attr/theme_color_page_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cv_main_pic" />

</androidx.constraintlayout.widget.ConstraintLayout>
