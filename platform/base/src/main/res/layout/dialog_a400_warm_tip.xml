<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/all_dialog_round_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_layout_64"
    android:paddingEnd="@dimen/margin_layout_64"
    android:paddingBottom="@dimen/margin_layout_80">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/tip_icon"
            android:layout_width="?attr/theme_icon_functions_large"
            android:layout_height="?attr/theme_icon_functions_large"
            android:layout_marginTop="@dimen/margin_layout_48"
            android:src="@drawable/ic_pic_a400_error_112x112"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressbar_dialog_parsing"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginTop="@dimen/margin_layout_64"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/white"
            app:indicatorSize="65dp"
            app:trackColor="@color/palette_white_transparent_20"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/title_tv"
            style="@style/AppTheme.TextTitleSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_48"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tip_tv"
            style="@style/AppTheme.TextBody2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_24"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/palette_white_silver"
            android:visibility="gone" />

    </LinearLayout>


</LinearLayout>
