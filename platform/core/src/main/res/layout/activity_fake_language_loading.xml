<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <View
        android:id="@+id/v_progress_bg"
        android:layout_width="272dp"
        android:layout_height="248dp"
        android:background="@drawable/shape_a400_change_language_dialog"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/white"
        app:indicatorSize="68dp"
        app:layout_constraintBottom_toBottomOf="@id/v_progress_bg"
        app:layout_constraintEnd_toEndOf="@id/v_progress_bg"
        app:layout_constraintStart_toStartOf="@id/v_progress_bg"
        app:layout_constraintTop_toTopOf="@id/v_progress_bg"
        app:trackColor="#33FFFFFF"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
