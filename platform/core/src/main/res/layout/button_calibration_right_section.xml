<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_calibration_mode"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/a400_bg_select_mode"
    android:paddingTop="@dimen/margin_layout_20"
    android:paddingBottom="@dimen/margin_layout_20">


    <TextView
        android:id="@+id/view_calibration_mode_check"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginStart="@dimen/margin_4dp"
        android:background="@drawable/icon_check" />

    <TextView
        android:id="@+id/tv_calibration_mode_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_12"
        android:layout_toEndOf="@+id/view_calibration_mode_check"
        android:gravity="center_vertical"
        android:text="@string/all_manual_mode"
        android:textColor="@color/palette_white_pure"
        android:textSize="@dimen/font_size_28sp" />


    <TextView
        android:id="@+id/tv_calibration_mode_content"
        style="@style/AppTheme.TextBody2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_calibration_mode_title"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/margin_layout_56"
        android:layout_marginBottom="@dimen/margin_layout_12"
        android:layout_toEndOf="@+id/view_calibration_mode_check"
        android:ellipsize="end"
        android:visibility="gone"
        tools:text="内容" />

</RelativeLayout>
