<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginStart="26dp"
        android:layout_marginTop="32dp"
        android:contentDescription="@string/placeholder"
        android:src="@drawable/ic_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:max="4"
        android:progress="1"
        app:indicatorColor="@color/palette_white_silver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_close"
        app:trackColor="@color/palette_grey_nero"
        app:trackThickness="2dp" />

    <TextView
        android:id="@+id/tv_main_title"
        style="@style/AppTheme.TextTitleSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="68dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="1-1 Manual Focus Calibration" />

    <TextView
        android:id="@+id/tv_sub_title"
        style="@style/AppTheme.TextExplain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/palette_grey_shallow"
        app:layout_constraintEnd_toEndOf="@id/tv_main_title"
        app:layout_constraintStart_toStartOf="@id/tv_main_title"
        app:layout_constraintTop_toBottomOf="@id/tv_main_title"
        tools:text="Touch Material (1/4)" />

    <ImageView
        android:id="@+id/iv_help"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_a400_sub_title_help"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/tv_sub_title"
        app:layout_constraintStart_toEndOf="@id/tv_sub_title"
        app:layout_constraintTop_toTopOf="@id/tv_sub_title"
        tools:visibility="invisible" />
</merge>
