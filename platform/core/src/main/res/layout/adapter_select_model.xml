<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_adapter_select_model"
    android:layout_width="550dp"
    android:layout_height="wrap_content"
    android:background="@drawable/a400_bg_select_mode">

    <ImageView
        android:id="@+id/iv_adapter_select_model_check"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginStart="@dimen/margin_4dp"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:src="@drawable/icon_check"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_adapter_select_model_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_32"
        android:textColor="@color/palette_white_pure"
        android:textSize="@dimen/font_size_28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/iv_adapter_select_model_check"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_adapter_select_model_content"
        style="@style/AppTheme.TextBody2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/margin_layout_56"
        android:layout_marginBottom="@dimen/margin_layout_32"
        android:ellipsize="end"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_adapter_select_model_title" />

</androidx.constraintlayout.widget.ConstraintLayout>
