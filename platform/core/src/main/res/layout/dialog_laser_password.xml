<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="580dp"
    android:layout_height="wrap_content"
    android:background="@drawable/all_dialog_round_background">

    <TextView
        android:id="@+id/tv_laser_password_title"
        style="@style/AppTheme.TextTitleSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:text="@string/a400_boot_up_laser_password_title"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_laser_password"
        style="@style/AppTheme.TextBody1"
        android:layout_width="444dp"
        android:layout_height="84dp"
        android:layout_marginTop="@dimen/margin_layout_48"
        android:background="@drawable/guide_calibration_black_bg"
        android:hint="@string/all_tap_to_enter"
        android:inputType="text"
        android:paddingLeft="@dimen/margin_layout_32"
        android:paddingRight="@dimen/margin_layout_32"
        android:textColor="@color/palette_white_pure"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_laser_password_title" />

    <Button
        android:id="@+id/btn_laser_password_confirm"
        style="@style/AppTheme.PrimaryButton"
        android:layout_width="230dp"
        android:layout_height="92dp"
        android:layout_marginTop="@dimen/margin_layout_48"
        android:layout_marginBottom="@dimen/margin_layout_24"
        android:text="@string/all_confirm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_laser_password" />

</androidx.constraintlayout.widget.ConstraintLayout>
