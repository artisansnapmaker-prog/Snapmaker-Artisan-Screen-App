<?xml version="1.0" encoding="utf-8"?>
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:horizontalGap="11.75dp"
    android:keyHeight="110.5dp"
    android:keyWidth="227dp"
    android:verticalGap="12.33dp" >

    <!--  Numbers Decimal First Row  -->
    <!--  1 2 3 4 [Backspace]  -->
    <Row>
        <Key
            android:codes="49"
            android:keyLabel="1" />
        <Key
            android:codes="50"
            android:keyLabel="2" />
        <Key
            android:codes="51"
            android:keyLabel="3" />
        <Key
            android:codes="52"
            android:keyLabel="4" />
        <Key
            android:codes="-5"
            android:isRepeatable="true"
            android:keyWidth="227dp"
            android:keyHeight="233dp"
            android:keyEdgeFlags="right" />
    </Row>

    <!--  Numbers Decimal Second Row  -->
    <!--  5 6 7 8  -->
    <Row>
        <Key
            android:codes="53"
            android:keyLabel="5" />
        <Key
            android:codes="54"
            android:keyLabel="6" />
        <Key
            android:codes="55"
            android:keyLabel="7" />
        <Key
            android:codes="56"
            android:keyLabel="8" />
    </Row>

    <!--  Numbers Decimal Third Row  -->
    <!--  9 0 . [Cancel] [Done]  -->
    <Row>
        <Key
            android:codes="57"
            android:keyLabel="9" />
        <Key
            android:codes="48"
            android:keyLabel="0" />
        <Key
            android:codes="46"
            android:keyLabel="." />

        <!--    Custom Key [Cancel]    -->
        <Key
            android:codes="200100"
            android:keyLabel="@string/all_cancel" />

        <!--    Custom Key [Done]    -->
        <Key
            android:codes="200200"
            android:keyWidth="227dp"
            android:keyEdgeFlags="right"
            android:keyLabel="@string/all_done" />
    </Row>

</Keyboard>
